# ==============================================================================
# HOUSING365 INDIA — PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# ==============================================================================
# IMPORTANT:
# - Copy this file to .env on the production server.
# - Generate a fresh APP_KEY using: php artisan key:generate
# - Ensure APP_DEBUG is strictly set to false in production.
# - SQLite is STRICTLY PROHIBITED. Use MySQL 8.x + InnoDB on port 3306.
# - Never commit production secrets to version control.
# ==============================================================================

# Application Identity & Security
APP_NAME="Housing 365 India"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://housing365.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_CURRENCY=INR
APP_CURRENCY_SYMBOL="₹"

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Production Logging
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Production Database (MySQL 8.x + InnoDB Required — Port 3306)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=housing365_prod
DB_USERNAME=housing365_user
DB_PASSWORD=YOUR_HIGH_ENTROPY_PRODUCTION_DB_PASSWORD

# Session Management (Encrypted & Secure HTTPS Cookies)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.housing365.in
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Caching & Background Queues
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Production Transactional Mailer (SMTP / SES / Postmark)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@housing365.in
MAIL_PASSWORD=YOUR_TRANSACTIONAL_MAIL_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="support@housing365.in"
MAIL_FROM_NAME="Housing 365 India"

# Live Payment Gateway (Merchant Credentials)
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY=YOUR_LIVE_MERCHANT_KEY_ID
PAYMENT_SECRET=YOUR_LIVE_MERCHANT_SECRET
PAYMENT_WEBHOOK_SECRET=YOUR_LIVE_WEBHOOK_SECRET

# Vite Production Assets
VITE_APP_NAME="${APP_NAME}"
